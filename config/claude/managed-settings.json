{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "additionalDirectories": [
      "/workspace",
      "/tmp"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/age.key)",
      "Read(**/*.agekey)",
      "Read(**/talosconfig)",
      "Read(/home/dev/.secrets/**)",
      "Read(/home/dev/.hermes/.env)",
      "Read(/home/dev/.hermes/auth.json)",
      "Read(/home/dev/.claude/.credentials.json)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(glab mr merge *)",
      "Bash(glab mr approve *)",
      "Bash(glab repo delete *)",
      "Read(/home/dev/.config/glab-cli/**)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh label list *)",
      "Bash(gh release view *)",
      "Bash(devsecops-gate *)",
      "Bash(devsecops-gate)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl explain *)",
      "Bash(flux get *)",
      "Bash(flux-local *)",
      "Bash(helm template *)",
      "Bash(helm show *)",
      "Bash(kustomize build *)",
      "Bash(kubeconform *)",
      "Bash(kube-linter *)",
      "Bash(shellcheck *)",
      "Bash(yamllint *)",
      "Bash(ansible-lint *)",
      "Bash(hadolint *)",
      "Bash(actionlint *)",
      "Bash(gitleaks *)",
      "Bash(trivy *)",
      "Bash(semgrep *)",
      "Bash(rg *)",
      "Bash(yq *)",
      "Bash(jq *)",
      "Bash(glab issue view *)",
      "Bash(glab issue list *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab mr list *)",
      "Bash(glab label list *)",
      "Bash(glab release view *)",
      "Bash(glab ci status *)",
      "Bash(ticket info *)",
      "Bash(ticket clone *)",
      "Bash(ticket ls *)",
      "Bash(ticket show *)",
      "Bash(docs-license *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/sandbox/bin/sandbox-guard --claude-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
