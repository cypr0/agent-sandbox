{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":timezone(Europe/Berlin)",
  ],
  schedule: ["every weekend"],
  labels: ["dependencies"],

  // Supply-chain safety: never propose a release younger than 3 days. Compromised
  // releases (e.g. of security tools) are usually pulled within that window.
  minimumReleaseAge: "3 days",

  // No automerge yet: there is no CI that builds the image. Review and run
  // "./sandbox.sh build" before merging an update PR.

  customManagers: [
    {
      customType: "regex",
      description: "Versions annotated with '# renovate: datasource=... depName=...' (Dockerfile ARGs, workflow env vars)",
      managerFilePatterns: [
        "/(^|/)Dockerfile$/",
        "/^templates/github/workflows/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+)?[A-Za-z0-9_]+\\s*[=:]\\s*\"?(?<currentValue>[^\\s\"]+)\"?",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
      extractVersionTemplate: "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}",
    },
  ],

  // The workflow template in templates/ is not under .github/workflows - include it.
  "github-actions": {
    managerFilePatterns: ["/^templates/github/workflows/.+\\.ya?ml$/"],
  },

  packageRules: [
    {
      description: "Pin the Debian base image and the CI images by digest",
      matchManagers: ["dockerfile", "gitlabci"],
      matchPackageNames: ["debian", "ghcr.io/gitleaks/gitleaks", "aquasec/trivy"],
      pinDigests: true,
    },
    {
      description: "Hermes images also carry calendar tags (v2026.x.y) and -desktop/rc variants - only follow vX.Y.Z",
      matchPackageNames: ["nousresearch/hermes-agent"],
      versioning: "regex:^v(?<major>\\d{1,3})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "One weekly PR for all non-major tool updates",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      groupName: "sandbox tools (non-major)",
    },
    {
      description: "Claude Code ships almost daily - let a release soak for a week (similar to the stable channel)",
      matchPackageNames: ["@anthropic-ai/claude-code"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Hermes Agent updates swap the bundled runtime (Python, Node, Chromium) - keep them in their own PR",
      matchPackageNames: ["nousresearch/hermes-agent"],
      groupName: "hermes-agent",
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
  ],
}
