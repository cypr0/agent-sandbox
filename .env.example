# =====================================================================
#  Agent sandbox settings. Copy to .env (./sandbox.sh does that on the
#  first start). NEVER commit .env.
# =====================================================================

# ---- Sandbox ---------------------------------------------------------
SANDBOX_NAME=agent-sandbox
# Folder with the Git clones (mounted to /workspace).
# Important: NOT an existing working copy that keeps keys or tokens next to the
# code (age.key, admin kubeconfig, ...). The agents clone fresh into this folder.
WORKSPACE_DIR=./workspace
TZ=Europe/Berlin
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g

# ---- Git identity of the agents -----------------------------------------
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---- Ticket workflow ----------------------------------------------------
# Repo for "ticket" when you are not inside a repo folder.
#   GitHub: owner/repo     GitLab: gitlab.com/group/project  (or <your-host>/group/project)
#   e.g. TICKET_DEFAULT_REPO=owner/k8s-ops
TICKET_DEFAULT_REPO=
# Repos searched by "ticket queue" and "sandbox-doctor" (space-separated, both forges mixed)
#   e.g. TICKET_REPOS="owner/k8s-ops gitlab.com/group/website"
TICKET_REPOS=
# Translate German input of "ticket new/approve/reject/block" to English via claude -p (1/0)
TICKET_TRANSLATE=1
# Additional protected branches (main/master always are), space-separated
PROTECTED_BRANCHES=

# ---- Documentation writer (/write-docs) -----------------------------------
# License for repos that have none (SPDX key: mit, apache-2.0, gpl-3.0, agpl-3.0, mpl-2.0,
# bsd-3-clause, unlicense ...). Empty = the agent asks you every time.
DOCS_LICENSE_DEFAULT=
# Copyright holder in LICENSE files (default: GIT_USER_NAME)
DOCS_COPYRIGHT_HOLDER=
# Where security issues are reported (e.g. an e-mail address). Empty = GitHub private
# vulnerability reporting / GitLab confidential issues.
DOCS_SECURITY_CONTACT=

# ---- GitHub -------------------------------------------------------------
# Fine-grained personal access token, only for the repos the agents work on:
#   Repository permissions: Contents RW, Issues RW, Pull requests RW, Metadata R
#   (+ Workflows RW if agents should change .github/workflows)
# Recommended: a token of a separate bot account without admin rights (see README).
GH_TOKEN=

# ---- GitLab (gitlab.com or self-hosted) -----------------------------------
# Recommended: a project/group access token with role "Developer" and scope "api".
# Developer can push branches and open MRs, but cannot push/merge to protected main.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com

# ---- Claude Code --------------------------------------------------------
# Leave empty to log in with your subscription (in the container: claude -> /login).
# Alternatively an API key from platform.claude.com (billed per token).
ANTHROPIC_API_KEY=
# Claude Code version: pinned in docker/Dockerfile and updated by Renovate.
# Override only to test something, e.g. CLAUDE_CODE_VERSION=latest
#CLAUDE_CODE_VERSION=

# ---- Hermes Agent -------------------------------------------------------
# Hermes needs its own provider access (the Claude subscription login is
# deliberately NOT shared). Examples:
#   OpenRouter:  HERMES_PROVIDER=openrouter  HERMES_MODEL=anthropic/claude-sonnet-4.6
#   Anthropic:   HERMES_PROVIDER=anthropic   HERMES_MODEL=claude-sonnet-4-6
#   Local:       HERMES_PROVIDER=custom      HERMES_BASE_URL=http://host.docker.internal:11434/v1  HERMES_MODEL=qwen3-coder
# Or leave empty and run "hermes model" in the container.
HERMES_PROVIDER=openrouter
HERMES_MODEL=
HERMES_BASE_URL=
HERMES_OPENROUTER_API_KEY=
HERMES_ANTHROPIC_API_KEY=
HERMES_OPENAI_API_KEY=
# Hermes version: pinned in docker/Dockerfile and updated by Renovate. Override only to test.
#HERMES_VERSION=

# ---- Ports for dev servers (bound to 127.0.0.1 only) ----------------------
PORT_WEB=3000
PORT_VITE=5173
PORT_ALT=8080

# ---- Advanced -------------------------------------------------------------
# Copy templates from config/ into the volumes again on every start (1)
SEED_OVERWRITE=0
# Extra Debian packages for the image (space-separated)
EXTRA_APT_PACKAGES=
